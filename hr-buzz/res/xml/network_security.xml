<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system certificates only. The coach is the only thing that uses the network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
