<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.emre.hrbuzz">

    <!-- The watch's own optical heart rate sensor. Android 16 moved it to the health permission. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Steps and cadence from the watch's step counter. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- GPS for distance and pace, asked for only when a run starts. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Keep the sensor and GPS alive with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Coach only (off until set up): HTTPS to api.deepseek.com, and the morning plan job. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-feature
        android:name="android.hardware.sensor.heartrate"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Watch"
        android:networkSecurityConfig="@xml/network_security">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />
        <!-- Works without the phone app: heart rate comes from the watch itself. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".StartActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LiveActivity"
            android:exported="false"
            android:theme="@style/WatchRun"
            android:launchMode="singleTop" />

        <activity
            android:name=".WearSummaryActivity"
            android:exported="false" />

        <activity
            android:name=".SportActivity"
            android:exported="false" />

        <activity
            android:name=".WearCoachActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <service
            android:name=".WorkService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".StepJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".CoachJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".WearService"
            android:exported="false"
            android:foregroundServiceType="health|location" />
    </application>
</manifest>
